{
    "name": "bohnmedia/media-codecs",
    "description": "Reads the complete media type including the RFC 6381 codecs parameter (e.g. video/mp4; codecs=\"av01.0.08M.08, mp4a.40.2\") from MP4/MOV and WebM/Matroska container headers – no external tools, no dependencies.",
    "license": "MIT",
    "type": "library",
    "keywords": ["mime", "media type", "codecs", "rfc6381", "av1", "hevc", "h264", "vp9", "mp4", "webm"],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": { "BohnMedia\\MediaCodecs\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "BohnMedia\\MediaCodecs\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --level=8 src tests"
    }
}
